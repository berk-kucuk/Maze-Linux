# --- Maze Linux (pulled from the [mazelinux] repo; see pacman.conf) ---
# Maze Linux signing keyring — listed explicitly and FIRST so pacman trusts the
# signatures of every other [mazelinux] package during pacstrap. (maze-meta also
# depends on it, but keep it explicit here for install ordering.)
mazelinux-keyring
# maze-meta — the SINGLE source of truth for the default Maze package set. It
# depends on every maze-* package (config, branding, and the default Maze apps:
# maze-guard, entropy-shield, qlam, hazedrop, haze, maze-ai, maze-connect,
# maze-cloak — NOT linux-chan-ai/sentinai, which can talk to Google Gemini) PLUS
# curated security tooling (firejail), so listing it here pulls the whole desktop
# in. To add a new default package: edit maze-meta's depends + bump pkgrel and
# republish — new ISOs get it here, and installed systems pick it up on
# `pacman -Syu`. Publish maze-meta AND everything it depends on to [mazelinux]
# BEFORE building the ISO, or mkarchiso fails with "target not found".
maze-meta
# maze-secureboot — the Secure Boot / UKI machinery (signer, kernel-install
# hook, self-heal units). maze-meta already depends on it; listed explicitly
# because deploy-to-target.sh now HARD-FAILS the Secure Boot setup without it.
maze-secureboot
# maze-installer is the live-ISO-only Calamares installer — deliberately NOT part
# of maze-meta (it must never land on an installed desktop), so list it here.
maze-installer
# Microsoft-signed shim (prebuilt by build-aur.sh into ./localrepo). Lives in the live system so build.sh can read
# /usr/share/shim-signed/{shimx64,mmx64}.efi for the ISO ESP, and so the installer
# can copy it onto the target ESP (it is AUR, not installable from official repos).
shim-signed
# base-devel + git so makepkg can build further AUR packages on the installed system
base-devel
git

# === Maze Linux: full security/privacy/AI desktop (official repos) ===
# Security & privacy
tor
torbrowser-launcher
onionshare
wireguard-tools
clamav
clamtk
firewalld
# fail2ban removed: it only guards sshd, which Maze ships disabled, so it
# protected nothing — and being tied to firewalld it went down with it and
# counted as a failed security service. Install it with sshd if you enable SSH.
apparmor
audit
lynis
rkhunter
libnotify
# usbguard — backs the USB kill switch in Maze Hardware (block NEW USB devices
# while keeping the ones currently plugged in working).
usbguard
aircrack-ng
wireshark-qt
openbsd-netcat
opensnitch
# AI
ollama
# Virtualization: intentionally NOT on the live ISO. The full stack
# (qemu-full pulled every foreign-arch emulator + firmware, ~2 GB uncompressed)
# is dead weight in a live session, so deploy-to-target.sh installs
# qemu-desktop/libvirt/virt-manager/edk2-ovmf on the INSTALLED system instead
# (network, best-effort). Only the guest agents stay on the ISO
# (qemu-guest-agent / virtualbox-guest-utils-nox above) so the live medium
# itself runs well INSIDE a VM.
# Desktop apps & utilities
discord
bitwarden
btop
fastfetch
bash-completion
wget
unzip
unrar
distrobox
filezilla
xsensors
acpi
acpid
network-manager-applet
ttf-nerd-fonts-symbols
isoimagewriter
btrfs-assistant
python-pip
python-setuptools
flatpak
fwupd
# Compressed RAM swap (configured via /etc/systemd/zram-generator.conf)
zram-generator
# Qt6/PySide6 for the Maze welcome app
pyside6

proton-vpn-gtk-app
tesseract-data-eng
tesseract-data-tur
wl-clipboard
# Gaming (multilib — enabled in pacman.conf).
# lib32-vulkan-{intel,radeon} are listed EXPLICITLY to satisfy steam's virtual
# lib32-vulkan-driver dependency with the mesa drivers. Without them pacman
# picked lib32-nvidia-utils as the provider, which dragged the whole
# proprietary NVIDIA userspace (nvidia-utils + lib32, ~1.4 GB uncompressed)
# onto the ISO even though the live session runs nouveau and no nvidia kernel
# module was ever installed. NVIDIA users get the real driver post-install via
# maze-gpu-driver (Arch's prebuilt nvidia-open / nvidia-open-lts + utils; DKMS only
# for non-Arch kernels).
steam
lib32-vulkan-intel
lib32-vulkan-radeon

# === Maze Linux: optional AUR apps (auto-managed by tools/build-aur.sh) ===
# If one of these fails to build, build-aur.sh comments it out (#MAZE-SKIP#)
# so the ISO build does not break. Do not hand-edit the #MAZE-SKIP# markers.
# obfs4proxy — Tor bridge transport used by entropy-shield (AUR-only since it
# left the official repos). Without it, enabling bridges wrote a
# ClientTransportPlugin line pointing at a missing binary and tor refused to
# start at all. entropy-shield >= 4.1.3 also guards for it at runtime.
obfs4proxy
upscayl-bin
session-desktop-bin
joplin-bin
claude-code
# paru — the AUR helper. Built from source against the same pacman/libalpm the
# ISO ships (so no ABI mismatch), instead of being compiled at install time
# (~3.5 min, Rust toolchain download, network-dependent). The installer's AUR
# step sees it already installed and skips it; it only builds paru when this
# line is missing.
paru
# Calamares graphical installer (live ISO only). Built from the AUR by
# build-aur.sh; Maze's own config + branding are shipped by the maze-installer
# package from [mazelinux].
calamares
# xhost — the maze-calamares launcher uses it to let root reach the live user's
# XWayland server (official repo; NOT auto-pulled by calamares).
xorg-xhost
# onlyoffice-bin is intentionally NOT shipped in the live ISO: it unpacks to
# ~1.3 GB and bloats the image. It is still installed on the INSTALLED system by
# deploy-to-target.sh (CURATED_AUR) / maze-aur-setup, built fresh from the AUR.

