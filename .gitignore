# --- Build output & work directories (regenerated by build scripts) ---
/out/
/work/
/localrepo/
/aur/

# --- Build backups & generated manifests ---
*.tar.zst
maze-build-backup-*
mazelinux-*-x86_64.txt
mazelinux-*-x86_64.iso
*.iso

# --- Secure Boot private signing key (NEVER commit) ---
keys/secureboot/*.key
keys/**/*.key
*.key
*.pem
*.p12
id_rsa*

# --- Local editor / tooling state ---
.claude/
.vscode/
.idea/

# --- Python / build artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- OS noise ---
.DS_Store
Thumbs.db
*.swp
*~
*.log

# --- Local scratch / vendored sources (not part of the build) ---
/src/

# Build transcripts written by build.sh
/logs/

# --- Backups & preview caches ---
*.bak
.thumbnails/

# --- Promo / video production (brag, hyperframes) — kept locally, not source ---
/brag-output*/
/videos/
/maze-promo/
