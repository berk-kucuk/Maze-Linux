[Unit]
Description=Maze Linux: honeypot canary monitor (deception layer)
After=auditd.service maze-honeypot-setup.service
Wants=auditd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/maze-honeypot
Restart=on-failure
RestartSec=5
# Runs as root: it reads the audit log and uses `sudo -u <user> notify-send` to
# alert each session, so it must keep full privileges (no NoNewPrivileges/sandbox
# that would block the sudo drop to the user bus).

[Install]
WantedBy=multi-user.target
