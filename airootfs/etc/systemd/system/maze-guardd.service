[Unit]
Description=Maze Linux: privileged-action broker (panic + hardware kill switches)
Documentation=man:maze-guardd
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/maze-guardd
Restart=on-failure
RestartSec=3
# NOTE: no RuntimeDirectory=maze — /run/maze is shared with the honeypot daemon
# (it writes /run/maze/honeypot-triggered there), and RuntimeDirectory would wipe
# that dir on every guardd restart. The daemon creates /run/maze itself.
# Runs as root (it must rfkill/modprobe/wipe logs), but the ONLY way in is the
# wheel-only socket with a fixed, non-eval verb whitelist.

[Install]
WantedBy=multi-user.target
