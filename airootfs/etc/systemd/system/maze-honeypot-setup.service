[Unit]
Description=Maze Linux: plant deception canaries and arm audit watches
After=auditd.service local-fs.target
Wants=auditd.service
ConditionPathExists=!/var/lib/maze/honeypot-setup.done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/maze-honeypot-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
