{
    "//": "Maze Linux archinstall config template. Copy to maze.json and edit.",
    "//validate": "archinstall --config maze.json --dry-run",
    "archinstall-language": "English",
    "hostname": "maze",
    "kernels": ["linux"],
    "ntp": true,
    "timezone": "UTC",
    "bootloader_config": {
        "bootloader": "Systemd-boot",
        "uki": true,
        "removable": true,
        "secure_boot": true
    },
    "packages": [
        "git",
        "vim",
        "sudo",
        "networkmanager"
    ],
    "services": ["NetworkManager"]
}
