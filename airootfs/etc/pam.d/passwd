#%PAM-1.0
#
# Maze Linux override of the stock 'shadow' /etc/pam.d/passwd.
#
# The only change is the pam_gnome_keyring line at the bottom. gnome-keyring is
# Maze's Secret Service owner (see packages.x86_64), and its "login" keyring is
# encrypted with whatever password the account had when PAM first created it.
# Without this hook, the moment the user changes their account password (passwd,
# or System Settings -> Users) the keyring stops matching and starts prompting on
# every single login. With it, PAM re-encrypts the keyring with the new password
# at the same time.
#
# The leading '-' means "skip silently if the module is not installed", so the
# file stays valid even if gnome-keyring is ever removed.
#
# A pacman upgrade of 'shadow' drops a /etc/pam.d/passwd.pacnew next to this file
# rather than replacing it; re-check it when that happens.

auth		include		system-auth
account		include		system-auth
password	include		system-auth
-password	optional	pam_gnome_keyring.so
