#!/usr/bin/env python3
"""
maze-control-center — Maze Linux OLED control dashboard.

A persistent companion to the first-boot welcome app: where Welcome *informs*,
the Control Center is the place to *check and act on* your system. It shows the
live state of the security services, privacy (MAC randomisation, Tor), the local
AI runtime and system maintenance.

Privileged actions (starting/stopping/enabling system services, changing the MAC,
updating the system) are NOT run by this app. Instead each one is presented as a
ready-to-run command with a one-click Copy button, so nothing happens without the
user deliberately running it in a terminal. Non-privileged information is read
live via the shared maze_status helper.
"""
from __future__ import annotations

import os
import sys

os.environ.setdefault("QT_QPA_PLATFORM", "xcb")

sys.path.insert(0, "/usr/local/lib/maze")
import maze_status  # noqa: E402
import maze_ui as ui  # noqa: E402
from maze_i18n import set_language, tr  # noqa: E402

from PySide6.QtCore import QPoint, Qt, QTimer  # noqa: E402
from PySide6.QtGui import QFont, QIcon, QPixmap  # noqa: E402
from PySide6.QtWidgets import (  # noqa: E402
    QApplication,
    QButtonGroup,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QPushButton,
    QScrollArea,
    QStackedWidget,
    QVBoxLayout,
    QWidget,
)

WIN_W, WIN_H = 980, 660


def summary_card(icon: str | tuple, title: str, value: str, tone: str) -> QFrame:
    card = QFrame()
    card.setStyleSheet(
        f"QFrame {{ background: {ui.PILL_BG}; border-radius: 14px;"
        " border: none; }"
    )
    lay = QVBoxLayout(card)
    lay.setContentsMargins(18, 16, 18, 16)
    lay.setSpacing(4)
    lay.addWidget(ui.icon_label(icon, 26))
    val = QLabel(value)
    val.setStyleSheet(f"color: {tone}; background: transparent;")
    val.setFont(QFont("Sans Serif", 17, QFont.Bold))
    lay.addWidget(val)
    name = QLabel(title)
    name.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
    name.setFont(QFont("Sans Serif", 9))
    lay.addWidget(name)
    return card


class ControlCenter(QWidget):
    def __init__(self) -> None:
        super().__init__()
        self._drag_offset: QPoint | None = None
        self.setWindowTitle("Maze Control Center")
        self.setWindowIcon(ui.logo_icon())
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.WindowSystemMenuHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setFixedSize(WIN_W, WIN_H)

        root = ui.Glass(ui.make_watermark(), self)
        root.setGeometry(0, 0, WIN_W, WIN_H)
        self._row = QHBoxLayout(root)
        self._row.setContentsMargins(0, 0, 0, 0)
        self._row.setSpacing(0)
        self._row.addWidget(self._build_sidebar())
        self._row.addWidget(self._build_content(), 1)

        # Live meters tick every 2s; cpu% needs a prior sample, so prime once.
        maze_status.cpu_usage_percent()
        self._meter_timer = QTimer(self)
        self._meter_timer.setInterval(2000)
        self._meter_timer.timeout.connect(self._refresh_meters)
        self._meter_timer.start()

    def _set_language(self, code: str) -> None:
        set_language(code)
        self._rebuild_ui()

    def _rebuild_ui(self) -> None:
        """Tear down sidebar + content and rebuild them in the active language."""
        while self._row.count():
            item = self._row.takeAt(0)
            w = item.widget()
            if w is not None:
                w.setParent(None)
                w.deleteLater()
        self._row.addWidget(self._build_sidebar())
        self._row.addWidget(self._build_content(), 1)

    def _refresh_meters(self) -> None:
        meters = getattr(self, "_meters", None)
        if not meters:
            return
        for mdef in maze_status.live_metrics():
            meter = meters.get(mdef["key"])
            if meter is not None:
                meter.update_value(mdef["percent"], mdef["detail"])

    # -- shell ----------------------------------------------------------------
    def _build_sidebar(self) -> QWidget:
        bar = QFrame()
        bar.setFixedWidth(210)
        bar.setStyleSheet("QFrame { background: rgba(255,255,255,0.025); }")
        lay = QVBoxLayout(bar)
        lay.setContentsMargins(16, 26, 16, 20)
        lay.setSpacing(6)

        logo = QLabel()
        logo.setAlignment(Qt.AlignCenter)
        logo.setStyleSheet("background: transparent;")
        pm = ui.logo_pixmap()
        if not pm.isNull():
            logo.setPixmap(pm.scaled(64, 64, Qt.KeepAspectRatio, Qt.SmoothTransformation))
        lay.addWidget(logo, 0, Qt.AlignHCenter)
        word = QLabel(tr("Control Center"))
        word.setAlignment(Qt.AlignCenter)
        word.setStyleSheet(f"color: {ui.TEXT}; background: transparent;")
        word.setFont(QFont("Sans Serif", 12, QFont.Bold))
        lay.addWidget(word)
        lay.addSpacing(16)

        self._nav_group = QButtonGroup(self)
        self._nav_group.setExclusive(True)
        for i, (icon, label) in enumerate([
            ("view-statistics", "Overview"),
            ("security-high", "Security"),
            ("user-identity", "Privacy"),
            ("network-wired", "Network"),
            ("applications-science", "AI"),
            ("lock", "Hardening"),
            ("applications-utilities", "Maintenance"),
        ]):
            btn = ui.NavButton(icon, tr(label))
            self._nav_group.addButton(btn, i)
            lay.addWidget(btn)
            if i == 0:
                btn.setChecked(True)
        self._nav_group.idClicked.connect(lambda i: self._stack.setCurrentIndex(i))
        lay.addStretch(1)
        lang = QLabel(tr("Language"))
        lang.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        lang.setFont(QFont("Sans Serif", 8, QFont.Bold))
        lay.addWidget(lang)
        lay.addWidget(ui.language_toggle(self._set_language))
        return bar

    def _build_content(self) -> QWidget:
        wrap = QFrame()
        wrap.setStyleSheet("QFrame { background: transparent; }")
        outer = QVBoxLayout(wrap)
        outer.setContentsMargins(30, 18, 30, 22)
        outer.setSpacing(0)

        bar = QHBoxLayout()
        bar.addStretch(1)
        close = QPushButton("✕")
        close.setCursor(Qt.PointingHandCursor)
        close.setFixedSize(30, 30)
        close.setStyleSheet(
            f"""
            QPushButton {{ color: {ui.DIM}; background: transparent; border: none;
                           font-size: 16px; border-radius: 15px; }}
            QPushButton:hover {{ color: white; background: rgba(224,68,68,0.25); }}
            """
        )
        close.clicked.connect(self.close)
        bar.addWidget(close)
        outer.addLayout(bar)

        self._stack = QStackedWidget()
        outer.addWidget(self._stack, 1)
        self._build_pages()

        outer.addSpacing(12)
        outer.addLayout(self._build_footer())
        return wrap

    def _build_pages(self) -> None:
        idx = self._stack.currentIndex() if self._stack.count() else 0
        while self._stack.count():
            w = self._stack.widget(0)
            self._stack.removeWidget(w)
            w.deleteLater()
        self._stack.addWidget(self._page_overview())
        self._stack.addWidget(self._page_security())
        self._stack.addWidget(self._page_privacy())
        self._stack.addWidget(self._page_network())
        self._stack.addWidget(self._page_ai())
        self._stack.addWidget(self._page_hardening())
        self._stack.addWidget(self._page_maintenance())
        self._stack.setCurrentIndex(idx)

    @staticmethod
    def _scroll_page() -> tuple[QWidget, QVBoxLayout]:
        # A real scroll area: pages whose content is taller than the window (e.g.
        # Network) now scroll instead of squashing their widgets together.
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        scroll.setVerticalScrollBarPolicy(Qt.ScrollBarAsNeeded)
        scroll.setStyleSheet("""
            QScrollArea { background: transparent; border: none; }
            QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
            QScrollBar::handle:vertical { background: rgba(255,255,255,0.18);
                                          border-radius: 4px; min-height: 32px; }
            QScrollBar::handle:vertical:hover { background: rgba(255,255,255,0.32); }
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
            QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
        """)
        inner = QWidget()
        inner.setStyleSheet("background: transparent;")
        col = QVBoxLayout(inner)
        col.setContentsMargins(0, 0, 8, 0)   # leave room for the scrollbar
        col.setSpacing(9)
        scroll.setWidget(inner)
        return scroll, col

    # -- pages ----------------------------------------------------------------
    def _page_overview(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Overview")))
        col.addWidget(ui.paragraph(tr("A live snapshot of your Maze system.")))
        col.addSpacing(4)

        # Live resource meters (auto-refreshed by self._meter_timer).
        self._meters = {}
        meters = QHBoxLayout()
        meters.setSpacing(12)
        for mdef in maze_status.live_metrics():
            mw = ui.Meter(mdef["icon"], mdef["label"])
            mw.update_value(mdef["percent"], mdef["detail"])
            self._meters[mdef["key"]] = mw
            meters.addWidget(mw)
        col.addLayout(meters)
        col.addSpacing(12)

        sec = maze_status.security_status()
        running = sum(1 for _, _, s in sec if s is True)
        total = len(sec)
        sec_tone = ui.OK_GREEN if running == total else (
            ui.BAD_RED if running == 0 else ui.TEXT)
        mac = maze_status.mac_randomization_enabled()
        ai_on = maze_status.ollama_status()
        _checks, score = maze_status.hardening_report()
        score_tone = (ui.OK_GREEN if score >= 80 else
                      ("#e0a458" if score >= 50 else ui.BAD_RED))

        grid = QGridLayout()
        grid.setSpacing(12)
        grid.addWidget(summary_card("security-high", tr("Security services"),
                                    f"{running}/{total}", sec_tone), 0, 0)
        grid.addWidget(summary_card("lock", tr("Hardening score"),
                                    f"{score}%", score_tone), 0, 1)
        grid.addWidget(summary_card("network-card", tr("MAC randomisation"),
                                    tr("On") if mac else tr("Off"),
                                    ui.OK_GREEN if mac else ui.BAD_RED), 0, 2)
        ai_val = (tr("On") if ai_on else tr("Off"))
        grid.addWidget(summary_card("applications-science", tr("Local AI (Ollama)"),
                                    ai_val,
                                    ui.OK_GREEN if ai_on else ui.UNK_GRAY), 0, 3)
        col.addLayout(grid)

        col.addSpacing(12)
        hw = QLabel(tr("Hardware & system"))
        hw.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        hw.setFont(QFont("Sans Serif", 9, QFont.Bold))
        col.addWidget(hw)

        facts = QGridLayout()
        facts.setSpacing(8)
        for n, (icon, value) in enumerate(maze_status.system_facts()):
            facts.addWidget(ui.icon_pill(icon, value), n // 2, n % 2)
        facts.setColumnStretch(0, 1)
        facts.setColumnStretch(1, 1)
        col.addLayout(facts)
        col.addStretch(1)
        return page

    def _page_security(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Security")))
        col.addWidget(ui.paragraph(tr(
            "Live state of the Maze defensive services. To change a service, copy "
            "its command and run it in a terminal."
        )))
        col.addSpacing(2)
        units = []
        for label, unit, state in maze_status.security_status():
            col.addWidget(ui.status_row(label, state, on_text="Running",
                                        off_text="Stopped"))
            units.append(unit)
        # Firmware Secure Boot state (read from the UEFI SecureBoot variable).
        col.addWidget(ui.status_row("Secure Boot", maze_status.secure_boot_status(),
                                    on_text="Enabled", off_text="Disabled",
                                    unk_text="Not available"))
        col.addSpacing(6)
        all_units = " ".join(units)
        col.addWidget(ui.CommandRow("Start all security services",
                                    f"sudo systemctl start {all_units}"))
        col.addWidget(ui.CommandRow("Enable them at every boot",
                                    f"sudo systemctl enable {all_units}"))
        col.addWidget(ui.CommandRow("Open the firewall configuration",
                                    "sudo firewall-config"))
        col.addStretch(1)
        return page

    def _page_privacy(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Privacy")))
        col.addWidget(ui.paragraph(tr(
            "Anonymity controls. MAC randomisation hides your hardware identity; "
            "Tor routes traffic anonymously."
        )))
        col.addSpacing(2)
        mac = maze_status.mac_randomization_enabled()
        col.addWidget(ui.status_row("MAC randomisation", mac, on_text="Enabled",
                                    off_text="Disabled"))
        col.addWidget(ui.status_row("Tor service", maze_status.tor_status(),
                                    on_text="Running", off_text="Stopped"))
        col.addSpacing(6)
        col.addWidget(ui.CommandRow("Randomise your MAC address now",
                                    "change-mac-now"))
        col.addWidget(ui.CommandRow("View MAC change logs", "mac-changer-logs"))
        col.addWidget(ui.CommandRow("Start Tor", "sudo systemctl start tor"))
        col.addStretch(1)
        return page

    def _page_network(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Network")))
        col.addWidget(ui.paragraph(tr(
            "Your connection and anonymity at a glance. Every check is local — "
            "Maze never contacts an external service to gather this."
        )))
        col.addSpacing(2)
        for label, value, good in maze_status.network_info():
            col.addWidget(ui.info_row(label, value, good))
        col.addSpacing(6)
        col.addWidget(ui.CommandRow("Open Proton VPN",
                                    "protonvpn-app"))
        col.addWidget(ui.CommandRow("Browse anonymously with Tor",
                                    "torbrowser-launcher"))
        col.addSpacing(6)
        col.addWidget(ui.paragraph(tr(
            "SSH server is OFF by default (an installed desktop should not expose "
            "one). Enable it only if you need to reach this machine remotely."
        )))
        col.addWidget(ui.CommandRow("Enable SSH server",
                                    "sudo systemctl enable --now sshd"))
        col.addWidget(ui.CommandRow("Disable SSH server",
                                    "sudo systemctl disable --now sshd"))
        col.addStretch(1)
        return page

    def _page_hardening(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Hardening")))
        col.addWidget(ui.paragraph(tr(
            "How locked down this system is right now, scored across Maze's "
            "core defences."
        )))
        col.addSpacing(2)

        checks, score = maze_status.hardening_report()
        passed = sum(1 for _, ok in checks if ok)
        tone = (ui.OK_GREEN if score >= 80 else
                ("#e0a458" if score >= 50 else ui.BAD_RED))
        banner = QFrame()
        banner.setFixedHeight(72)
        banner.setStyleSheet(
            f"QFrame {{ background: {ui.PILL_BG}; border-radius: 14px; }}")
        bl = QHBoxLayout(banner)
        bl.setContentsMargins(20, 14, 20, 14)
        bl.setSpacing(16)
        big = QLabel(f"{score}%")
        big.setStyleSheet(f"color: {tone}; background: transparent;")
        big.setFont(QFont("Sans Serif", 30, QFont.Bold))
        bl.addWidget(big)
        txtcol = QVBoxLayout()
        txtcol.setSpacing(2)
        t1 = QLabel(tr("Security score"))
        t1.setStyleSheet(f"color: {ui.TEXT}; background: transparent;")
        t1.setFont(QFont("Sans Serif", 12, QFont.Bold))
        t2 = QLabel(tr("{passed} of {total} checks passed").format(
            passed=passed, total=len(checks)))
        t2.setStyleSheet(f"color: {ui.DIM}; background: transparent;")
        t2.setFont(QFont("Sans Serif", 10))
        txtcol.addWidget(t1)
        txtcol.addWidget(t2)
        bl.addLayout(txtcol)
        bl.addStretch(1)
        col.addWidget(banner)
        col.addSpacing(6)

        cgrid = QGridLayout()
        cgrid.setSpacing(8)
        for n, (label, ok) in enumerate(checks):
            cgrid.addWidget(
                ui.status_row(label, ok, on_text="Pass", off_text="Fail"),
                n // 2, n % 2)
        cgrid.setColumnStretch(0, 1)
        cgrid.setColumnStretch(1, 1)
        col.addLayout(cgrid)
        col.addStretch(1)
        return page

    def _page_ai(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Artificial Intelligence")))
        col.addWidget(ui.paragraph(tr(
            "Run large language models locally and offline with Ollama."
        )))
        col.addSpacing(2)
        col.addWidget(ui.status_row("Ollama service", maze_status.ollama_status(),
                                    on_text="Running", off_text="Stopped"))
        models = maze_status.ollama_models()
        if models:
            lab = QLabel(tr("Installed models"))
            lab.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
            lab.setFont(QFont("Sans Serif", 9, QFont.Bold))
            col.addWidget(lab)
            for name in models[:5]:
                col.addWidget(ui.status_row(name, True, on_text="Ready"))
        col.addSpacing(6)
        col.addWidget(ui.CommandRow("Pull a model", "ollama pull llama3"))
        col.addWidget(ui.CommandRow("Chat with a model", "ollama run llama3"))
        col.addWidget(ui.CommandRow("Remove a model", "ollama rm <model>"))
        col.addStretch(1)
        return page

    def _page_maintenance(self) -> QWidget:
        page, col = self._scroll_page()
        col.addWidget(ui.heading(tr("Maintenance")))
        col.addWidget(ui.paragraph(tr(
            "Keep Maze healthy and up to date. Copy a command and run it when ready."
        )))
        col.addSpacing(2)
        col.addWidget(ui.CommandRow("Update the whole system", "sudo pacman -Syu"))
        col.addWidget(ui.CommandRow("Update firmware", "fwupdmgr update"))
        col.addWidget(ui.CommandRow("Antivirus scan of your home folder",
                                    "clamscan -r --bell -i ~"))
        col.addWidget(ui.CommandRow("Rootkit check", "sudo rkhunter --check"))
        col.addWidget(ui.CommandRow("Security audit", "sudo lynis audit system"))
        col.addWidget(ui.CommandRow("Clean old package cache", "sudo paccache -rk2"))
        col.addStretch(1)
        return page

    # -- footer ---------------------------------------------------------------
    def _build_footer(self) -> QHBoxLayout:
        f = QHBoxLayout()
        hint = QLabel(tr(
            "Actions are shown as commands — copy and run them in a terminal."))
        hint.setStyleSheet(f"color: {ui.FAINT}; background: transparent;")
        hint.setFont(QFont("Sans Serif", 9))
        f.addWidget(hint)
        f.addStretch(1)

        refresh = QPushButton(f"⟳  {tr('Refresh')}")
        refresh.setCursor(Qt.PointingHandCursor)
        refresh.setFixedHeight(42)
        refresh.setStyleSheet(
            f"""
            QPushButton {{ color: {ui.TEXT}; background: rgba(255,255,255,0.08);
                           border: none; border-radius: 12px; padding: 0 22px;
                           font-size: 12px; }}
            QPushButton:hover {{ background: rgba(255,255,255,0.16); }}
            """
        )
        refresh.clicked.connect(self._build_pages)

        close = QPushButton(tr("Close"))
        close.setCursor(Qt.PointingHandCursor)
        close.setFixedHeight(42)
        close.setStyleSheet(
            f"""
            QPushButton {{ color: #16181d; background: {ui.ACCENT}; border: none;
                           border-radius: 12px; padding: 0 26px;
                           font-size: 12px; font-weight: bold; }}
            QPushButton:hover {{ background: {ui.ACCENT_HOVER}; }}
            """
        )
        close.clicked.connect(self.close)
        f.addWidget(refresh)
        f.addSpacing(10)
        f.addWidget(close)
        return f

    # -- window behaviour -----------------------------------------------------
    def show_centered(self) -> None:
        screen = QApplication.primaryScreen().availableGeometry()
        geo = self.frameGeometry()
        geo.moveCenter(screen.center())
        self.move(geo.topLeft())
        self.show()
        ui.enable_kde_blur(int(self.winId()))

    def mousePressEvent(self, event) -> None:  # noqa: N802
        if event.button() == Qt.LeftButton and event.position().y() < 70:
            self._drag_offset = event.globalPosition().toPoint() - self.pos()

    def mouseMoveEvent(self, event) -> None:  # noqa: N802
        if self._drag_offset is not None and event.buttons() & Qt.LeftButton:
            self.move(event.globalPosition().toPoint() - self._drag_offset)

    def mouseReleaseEvent(self, event) -> None:  # noqa: N802
        self._drag_offset = None

    def keyPressEvent(self, event) -> None:  # noqa: N802
        if event.key() == Qt.Key_Escape:
            self.close()
            return
        super().keyPressEvent(event)


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("Maze Control Center")
    # Associate the window with its .desktop entry so the taskbar/dock shows the
    # Maze logo instead of the generic XWayland icon. Qt uses the desktop file
    # name for the X11 WM_CLASS, which StartupWMClass in the .desktop matches.
    app.setDesktopFileName("maze-control-center")
    app.setWindowIcon(ui.logo_icon())
    win = ControlCenter()
    win.show_centered()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
