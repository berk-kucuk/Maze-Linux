        QPushButton,
        QScrollArea,
        QStackedWidget,
        QVBoxLayout,
        QWidget,
    )
except ImportError:
    sys.stderr.write(
        'maze-installer-gui: PySide6 is required (pacman -S pyside6).\n'
        'Falling back to the terminal installer: run `mazeinstaller --cli`.\n'
    )
    raise SystemExit(1)

