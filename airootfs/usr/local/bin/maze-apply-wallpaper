#!/bin/sh
# maze-apply-wallpaper — force the Maze active-blur (a2n.blur) wallpaper on every
# desktop at runtime, then disable itself (runs once on first login).
#
# WHY: the skel sets wallpaperplugin=a2n.blur, but Plasma falls back to a plain
# org.kde.image desktop when the skel's screen mapping doesn't match the actual
# hardware (a VM, or different monitors than the build host) — so the user gets
# the "Image" wallpaper type instead of Active Blur. Applying it through Plasma
# scripting AFTER the desktops exist sidesteps the containment/screen mismatch.
set -u

MARKER="${HOME}/.config/maze-wallpaper.done"
[ -f "${MARKER}" ] && exit 0

QDBUS=""
for c in qdbus6 qdbus qdbus-qt6; do command -v "$c" >/dev/null 2>&1 && { QDBUS="$c"; break; }; done
[ -n "${QDBUS}" ] || exit 0

# Wait for plasmashell's scripting interface to be ready.
i=0
while [ "$i" -lt 30 ]; do
    "${QDBUS}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'print(1)' >/dev/null 2>&1 && break
    i=$((i + 1)); sleep 2
done

SCRIPT='
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    d.wallpaperPlugin = "a2n.blur";
    d.currentConfigGroup = ["Wallpaper", "a2n.blur", "General"];
    d.writeConfig("Image", "file:///usr/share/wallpapers/Maze/contents/images/3344x1882.png");
    d.writeConfig("BlurRadius", 50);
    d.writeConfig("AnimationDuration", 250);
    d.writeConfig("SlidePaths", "/usr/share/wallpapers/");
    d.reloadConfig();
}'

if "${QDBUS}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "${SCRIPT}" >/dev/null 2>&1; then
    touch "${MARKER}"
fi

# Run only once — drop our own autostart entry.
rm -f "${HOME}/.config/autostart/maze-apply-wallpaper.desktop" 2>/dev/null || true
exit 0
