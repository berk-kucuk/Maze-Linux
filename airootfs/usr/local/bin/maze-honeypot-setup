#!/usr/bin/env bash
# maze-honeypot-setup — plant Maze's deception canaries and arm the audit watches.
#
# Places fake, tempting files (SSH private keys, a crypto wallet, a KeePass DB, a
# /etc/passwd backup) that NOTHING legitimate ever touches, then adds auditd
# watch rules so any read/write is logged with key=maze_honeypot. The
# maze-honeypot daemon reacts to those events. Runs once on first boot (oneshot
# service), after auditd. Re-runnable (idempotent).
set -uo pipefail

CANARY_KEY="maze_honeypot"
RULES="/etc/audit/rules.d/maze-honeypot.rules"
MARKER="/var/lib/maze/honeypot-setup.done"
log() { printf '[maze-honeypot-setup] %s\n' "$*"; }

mkdir -p /var/lib/maze
CANARIES=()

# Plant a canary only if absent; record it for the audit rules. Paths must NOT
# contain spaces (auditd watch rules don't handle them).
plant() {
    local path="$1" content="$2" owner="${3:-root:root}" mode="${4:-600}"
    if [[ ! -e "${path}" ]]; then
        mkdir -p "$(dirname "${path}")"
        printf '%s\n' "${content}" > "${path}" 2>/dev/null || return 0
        chmod "${mode}" "${path}" 2>/dev/null || true
        chown "${owner}" "${path}" 2>/dev/null || true
    fi
    CANARIES+=("${path}")
}

fake_ssh_key() {
    cat <<'KEY'
-----BEGIN OPENSSH PRIVATE KEY-----
b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
QyNTUxOQAAACDQm3l0Rf+9DECOY1FAKEFAKEFAKEcanaryDoNotUseAAAAJiM4r0sjOK9
LAAAAAtzc2gtZWQyNTUxOQAAACDQm3l0Rf+9DECOY1FAKEFAKEFAKEcanaryDoNotUse
-----END OPENSSH PRIVATE KEY-----
KEY
}
fake_wallet() {
    cat <<'W'
# Bitcoin Core wallet backup (DO NOT SHARE)
xprv9s21ZrQH143K3FAKEcanaryDoNotUseFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE
seed: ginger absent canary trap decoy maze sentinel alarm fake fake fake fake
W
}
fake_keepass() { printf 'KDBX-FAKE-CANARY\x00MazeDeceptionDoNotUseRealCredentials'; }
fake_passwd() {
    cat <<'P'
root:x:0:0::/root:/bin/bash
admin:x:1000:1000:admin:/home/admin:/bin/bash
backup-svc:$6$canaryFAKEhashDoNotCrackThisItIsADecoy:1001:1001::/home/backup-svc:/bin/bash
P
}

log "Planting deception canaries"
# Root-owned bait — for an attacker who escalated to root.
plant /root/.ssh/id_rsa            "$(fake_ssh_key)"
plant /root/wallet.dat             "$(fake_wallet)"
plant /opt/backup/passwords.kdbx   "$(fake_keepass)"
plant /etc/maze-canary/passwd.bak  "$(fake_passwd)"
plant /var/backups/shadow.bak      "$(fake_passwd)"

# Per-user bait in every human home. NOTE: deliberately NOT ~/.ssh/id_ed25519 or
# ~/.ssh/id_rsa — those are ssh-keygen's DEFAULT output paths, so a canary there
# would collide with the user generating a real key (and the file indexer never
# touches these hidden paths, so no false positives).
for home in /home/*; do
    [[ -d "${home}" ]] || continue
    user="$(stat -c '%U' "${home}" 2>/dev/null || basename "${home}")"
    plant "${home}/.ssh/id_rsa.bak"               "$(fake_ssh_key)"     "${user}:${user}"
    plant "${home}/.config/maze-wallet-seed.txt"  "$(fake_wallet)"      "${user}:${user}"
done

# Arm the audit watches (read/write/attr => key=maze_honeypot).
log "Arming auditd watches (${#CANARIES[@]} canaries)"
{
    echo "# Maze Linux honeypot canaries — generated by maze-honeypot-setup."
    for c in "${CANARIES[@]}"; do
        printf -- '-w %s -p rwa -k %s\n' "${c}" "${CANARY_KEY}"
    done
} > "${RULES}"
chmod 640 "${RULES}" 2>/dev/null || true

# Load the rules into the running kernel audit (augenrules merges all rules.d).
if command -v augenrules >/dev/null 2>&1; then
    augenrules --load >/dev/null 2>&1 || true
fi
auditctl -R "${RULES}" >/dev/null 2>&1 || true

touch "${MARKER}"
log "Honeypot armed."
exit 0
