#!/usr/bin/env bash
#
# maze-install-gui — open the Maze guided installer in a terminal window.
#
# This is what the "Install Maze Linux" desktop launcher runs. The previous
# launcher used `kstart --maximize konsole ...` directly, but KF6's kstart
# dropped the `--maximize` option (Wayland can't honor it), so the whole command
# errored out and *nothing opened*. Konsole itself is always present, so here we
# guarantee a window opens: try a maximized launch first, and fall back to a
# plain Konsole window if that fails for any reason. We deliberately avoid
# --fullscreen (it hides the panel/titlebar).
#
set -u

# Best effort: a maximized window via kstart, only if kstart accepts it.
# `kstart` returns non-zero when it rejects the option, in which case we fall
# through to the plain launch below (no double window — it only spawns Konsole
# when the options parse successfully).
if command -v kstart >/dev/null 2>&1; then
    if kstart --maximize konsole --hold -e sudo maze-install 2>/dev/null; then
        exit 0
    fi
fi

# Guaranteed fallback: a normal (resizable) Konsole window.
exec konsole --hold -e sudo maze-install
