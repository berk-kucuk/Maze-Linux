#!/usr/bin/env bash
#
# maze-install — Maze Linux guided installer.
#
# Branded front-end around our *customized fork* of archinstall, which is
# vendored at /opt/maze-archinstall (upstream: github.com/archlinux/archinstall).
# We run that fork via PYTHONPATH so it takes precedence over the packaged
# archinstall; the distro package is still installed only to satisfy the Python
# dependencies (pydantic, pyparted, textual, ...).
#
# It works out of the box (launches the interactive TUI) and is the single
# entry point we customize over time — first via the data files below, later
# via a dedicated GUI front-end that produces the same config/credentials files.
#
# Customization data (all optional; used only if present):
#   /etc/maze-installer/maze.json   -> passed to `archinstall --config`
#   /etc/maze-installer/creds.json  -> passed to `archinstall --creds`
#
# Any extra arguments are forwarded verbatim to archinstall, e.g.:
#   maze-install --silent            (unattended, requires a complete config)
#   maze-install --advanced
#
set -euo pipefail

CONFIG_DIR="/etc/maze-installer"
CONFIG_FILE="${CONFIG_DIR}/maze.json"
CREDS_FILE="${CONFIG_DIR}/creds.json"
FORK_DIR="/opt/maze-archinstall"

c_reset=$'\e[0m'; c_accent=$'\e[97m'; c_warn=$'\e[33m'

require_root() {
    if [[ ${EUID} -ne 0 ]]; then
        echo "maze-install must run as root; re-executing with sudo..." >&2
        exec sudo -- "$0" "$@"
    fi
}

check_archinstall() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "Error: python3 is not available in this environment." >&2
        exit 1
    fi
    if [[ ! -d "${FORK_DIR}/archinstall" ]]; then
        echo "Error: Maze archinstall fork not found at ${FORK_DIR}." >&2
        exit 1
    fi
}

check_network() {
    # Bounded connectivity probe. IMPORTANT: `ping -W` only caps the wait for the
    # ICMP *reply*, NOT the DNS name lookup — so on a VM with a slow/broken
    # resolver, `ping archlinux.org` would hang on getaddrinfo() for minutes
    # before the installer even started. We therefore (a) wrap the whole thing in
    # `timeout` so it can never take more than a few seconds, and (b) never block
    # on a prompt: this is only a courtesy heads-up. archinstall runs its own
    # (also bounded) online check against an IP and offers Wi-Fi setup, so it is
    # safe to just continue.
    if timeout 4 ping -c1 -W2 archlinux.org >/dev/null 2>&1; then
        return 0
    fi
    printf '%sNote:%s no internet connection detected yet (or DNS is not ready).\n' "${c_warn}" "${c_reset}"
    echo "  - Ethernet/DHCP should connect automatically."
    echo "  - Wi-Fi can be set up in the next step, or with: iwctl / nmtui"
    echo "  Continuing — the installer will check again and guide you if needed."
    echo
}

main() {
    require_root "$@"
    check_archinstall
    check_network

    local args=()
    if [[ -f "${CONFIG_FILE}" ]]; then
        echo "Using configuration: ${CONFIG_FILE}"
        args+=(--config "${CONFIG_FILE}")
    fi
    if [[ -f "${CREDS_FILE}" ]]; then
        echo "Using credentials:   ${CREDS_FILE}"
        args+=(--creds "${CREDS_FILE}")
    fi
    [[ ${#args[@]} -gt 0 ]] && echo

    # The installer menu now opens almost immediately: the slow up-front work
    # (online version lookup + a blocking `pacman -Sy` that stalled while
    # reflector was still rating mirrors at boot) has been removed. The package
    # database is synced later, right before packages are installed.
    printf '%sStarting the Maze installer…%s\n' "${c_accent}" "${c_reset}"
    echo "  Detailed logs: /var/log/archinstall/install.log"
    echo

    # Prepend our fork so `import archinstall` resolves to the customized copy.
    export PYTHONPATH="${FORK_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
    # Unbuffered stdout/stderr so progress messages appear immediately instead
    # of being held back in Python's output buffer during the startup pause.
    exec python3 -u -m archinstall "${args[@]}" "$@"
}

main "$@"
