#!/bin/sh
# maze-killswitch — UNPRIVILEGED front-end for the hardware kill switches.
#
# All the privileged work now lives in maze-guardd (root daemon, fixed API, no
# setuid/pkexec). This is a thin translator kept under the familiar name so the
# Maze Hardware GUI and the CLI are unchanged:
#     maze-killswitch status                       -> guard STATUS
#     maze-killswitch <device> <on|off>            -> guard KILL <device> <on|off>
# Devices: camera | microphone | bluetooth | wifi | usb
set -u

case "${1:-status}" in
    status)
        exec maze-guard status
        ;;
    camera|microphone|mic|bluetooth|wifi|usb)
        dev="$1"; [ "$dev" = "mic" ] && dev="microphone"
        act="${2:-status}"
        case "${act}" in
            on|off) exec maze-guard kill "${dev}" "${act}" ;;
            *) echo "usage: maze-killswitch ${dev} <on|off>" >&2; exit 2 ;;
        esac
        ;;
    *)
        echo "usage: maze-killswitch <camera|microphone|bluetooth|wifi|usb> <on|off> | status" >&2
        exit 2
        ;;
esac
