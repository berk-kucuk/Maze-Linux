#!/bin/sh
# maze-panic — Maze Panic mode (user-facing trigger).
#
# Bound to Ctrl+Alt+P and to the panic tray icon. Clears the CURRENT user's
# traces, cuts networking, asks the maze-guardd broker (via the unprivileged
# maze-guard client — no pkexec/setuid) to do the system-level wipe, then locks
# the session. NON-DESTRUCTIVE: it clears history/traces and cuts the net —
# it does NOT delete user data or break the system. You can re-enable the network
# afterwards (rfkill unblock all; nmcli networking on).
set -u

# --- 1) This user's shell / tool history files ----------------------------
for h in "$HOME/.bash_history" "$HOME/.zsh_history" "$HOME/.histfile" \
         "$HOME/.local/share/fish/fish_history" "$HOME/.python_history" \
         "$HOME/.lesshst" "$HOME/.node_repl_history" "$HOME/.sqlite_history" \
         "$HOME/.wget-hsts" "$HOME/.viminfo"; do
    [ -e "$h" ] && : > "$h" 2>/dev/null || true
done

# --- 2) Recently-used lists, thumbnails, clipboard ------------------------
rm -f  "$HOME/.local/share/RecentDocuments/"*.desktop 2>/dev/null || true
rm -f  "$HOME/.local/share/recently-used.xbel"        2>/dev/null || true
rm -rf "$HOME/.cache/thumbnails/"*                    2>/dev/null || true
# KDE Klipper clipboard history (Qt5 + Qt6 tool names).
qdbus  org.kde.klipper /klipper clearClipboardHistory 2>/dev/null || true
qdbus6 org.kde.klipper /klipper clearClipboardHistory 2>/dev/null || true
# Wayland clipboard, if the tool is present.
command -v wl-copy >/dev/null 2>&1 && printf '' | wl-copy 2>/dev/null || true

# --- 3) Cut the network from the user side --------------------------------
nmcli networking off 2>/dev/null || true

# --- 4) System-level wipe (radios, journal, logs, caches) -----------------
# Ask the privileged broker (maze-guardd) to do the root-only part. NO pkexec /
# setuid in the path: maze-guard is unprivileged and can only send the fixed
# "panic" verb to the wheel-only daemon socket.
maze-guard panic >/dev/null 2>&1 || true

# --- 5) Tell the user, then lock the session ------------------------------
notify-send -a "Maze Panic" -u critical -i security-high \
    "Panic mode activated" \
    "Network cut · logs & history wiped · session locked. (Re-enable net: rfkill unblock all && nmcli networking on)" \
    2>/dev/null || true

loginctl lock-session 2>/dev/null \
    || qdbus  org.kde.screensaver /ScreenSaver Lock 2>/dev/null \
    || qdbus6 org.freedesktop.ScreenSaver /ScreenSaver Lock 2>/dev/null \
    || true

exit 0
