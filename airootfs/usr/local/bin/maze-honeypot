#!/usr/bin/env bash
# maze-honeypot — react to access of any Maze deception canary.
#
# Tails the kernel audit log for records tagged key="maze_honeypot" (set by the
# watches maze-honeypot-setup installed). When a canary is touched — which NOTHING
# legitimate ever does — it raises a loud, system-wide alert: a desktop
# notification to every logged-in user, an entry in /var/log/maze-honeypot.log,
# and a trigger file other Maze tools (Sentinel) can watch. Optional auto-lockdown
# (cut the network) is OFF by default to avoid locking the owner out on a false
# positive; enable it in /etc/maze/honeypot.conf.
set -uo pipefail

AUDIT_LOG="/var/log/audit/audit.log"
ALERT_LOG="/var/log/maze-honeypot.log"
TRIGGER_DIR="/run/maze"
CONF="/etc/maze/honeypot.conf"

# Defaults (overridable in $CONF).
AUTO_LOCKDOWN=0
NOTIFY=1
# shellcheck source=/dev/null
[[ -r "${CONF}" ]] && . "${CONF}"

mkdir -p "${TRIGGER_DIR}" 2>/dev/null || true
touch "${ALERT_LOG}" 2>/dev/null || true

# Send a desktop notification to every active user (same /run/user trick as the
# Maze MAC notifier).
notify_all() {
    local title="$1" body="$2"
    [[ "${NOTIFY}" = "1" ]] || return 0
    local uid user addr
    for uid in $(ls /run/user 2>/dev/null); do
        [[ -S "/run/user/${uid}/bus" ]] || continue
        user="$(id -nu "${uid}" 2>/dev/null)" || continue
        addr="unix:path=/run/user/${uid}/bus"
        sudo -u "${user}" env DBUS_SESSION_BUS_ADDRESS="${addr}" \
            notify-send -a "Maze Sentinel" -u critical -i security-high \
            "${title}" "${body}" >/dev/null 2>&1 || true
    done
}

react() {
    local raw="$1"
    # Pull a few useful fields out of the SYSCALL record for the alert.
    local exe uid comm pid ts
    exe="$(sed -n 's/.* exe="\([^"]*\)".*/\1/p'  <<<"${raw}")"
    comm="$(sed -n 's/.* comm="\([^"]*\)".*/\1/p' <<<"${raw}")"
    uid="$(sed -n 's/.* uid=\([0-9]*\).*/\1/p'    <<<"${raw}" | head -1)"
    pid="$(sed -n 's/.* pid=\([0-9]*\).*/\1/p'    <<<"${raw}" | head -1)"
    ts="$(date '+%Y-%m-%d %H:%M:%S')"

    local who="process ${comm:-?} (pid ${pid:-?}, uid ${uid:-?}, ${exe:-?})"
    printf '%s  HONEYPOT TRIGGERED by %s\n    %s\n' "${ts}" "${who}" "${raw}" \
        >> "${ALERT_LOG}" 2>/dev/null || true

    # Forensic trigger file for Maze Sentinel / dashboards.
    {
        echo "time=${ts}"
        echo "exe=${exe}"
        echo "comm=${comm}"
        echo "uid=${uid}"
        echo "pid=${pid}"
    } > "${TRIGGER_DIR}/honeypot-triggered" 2>/dev/null || true

    notify_all "⚠ Intrusion detected" \
        "A Maze honeypot canary was accessed by ${comm:-a process} (uid ${uid:-?}). This is never normal — investigate now. Details: ${ALERT_LOG}"

    if [[ "${AUTO_LOCKDOWN}" = "1" ]]; then
        printf '%s  AUTO-LOCKDOWN: cutting network\n' "${ts}" >> "${ALERT_LOG}"
        # Wi-Fi + mobile only (not bluetooth — keep BT input devices alive).
        rfkill block wifi 2>/dev/null || true
        rfkill block wwan 2>/dev/null || true
        nmcli networking off 2>/dev/null || true
    fi
}

# Wait for the audit log to exist (auditd may start just after us).
for _ in $(seq 1 30); do [[ -e "${AUDIT_LOG}" ]] && break; sleep 2; done
[[ -e "${AUDIT_LOG}" ]] || { echo "maze-honeypot: no audit log; is auditd running?" >&2; exit 1; }

# Follow the log across rotation/truncation (-F). De-bounce repeated SYSCALL lines
# of one access by only acting on the SYSCALL record (it carries exe/uid/comm).
tail -Fn0 "${AUDIT_LOG}" 2>/dev/null | while IFS= read -r line; do
    case "${line}" in
        *'key="maze_honeypot"'*|*'key=6D617A655F686F6E6579706F74'*)
            case "${line}" in *type=SYSCALL*) react "${line}" ;; esac
            ;;
    esac
done
